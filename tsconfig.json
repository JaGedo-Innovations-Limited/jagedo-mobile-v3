{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@/*":        ["./*"],
      "@modules/*": ["./src/modules/*"],
      "@shared/*":  ["./src/shared/*"],
      "@services/*":["./src/services/*"],
      "@config/*":  ["./src/config/*"]
    }
  },
  "exclude": ["dist", "node_modules"]
}
